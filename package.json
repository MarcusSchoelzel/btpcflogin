{
  "name": "btpcflogin",
  "version": "2.0.0",
  "description": "Easy login to SAP BTP Cloud Foundry (cf cli)",
  "author": "Marcus Schölzel <marcus.schoelzel@gmx.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcusSchoelzel/btpcflogin.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "lib/index.js",
  "type": "module",
  "bin": {
    "btpcflogin": "lib/index.js"
  },
  "scripts": {
    "prepack": "tsc",
    "local": "tsx ./src/index.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "format": "prettier -w ./src ./test"
  },
  "dependencies": {
    "@inquirer/core": "^12.1.1",
    "@inquirer/prompts": "^8.8.1",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "configstore": "^8.0.0",
    "figlet": "^1.13.0",
    "ora": "^10.0.0",
    "which": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.7",
    "@types/configstore": "^6.0.2",
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.6.6",
    "@types/which": "^3.0.4",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "printWidth": 120
  },
  "os": [
    "linux",
    "win32",
    "darwin"
  ],
  "keywords": [
    "btp",
    "cli",
    "cloudfoundry",
    "regions",
    "sap"
  ]
}
