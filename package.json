{
  "name": "btpcflogin",
  "version": "1.5.2",
  "description": "Easy login to SAP BTP Cloud Foundry (cf cli)",
  "author": "Marcus Schölzel <marcus.schoelzel@gmx.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcusSchoelzel/btpcflogin.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "lib/index.js",
  "type": "module",
  "bin": {
    "btpcflogin": "lib/index.js"
  },
  "scripts": {
    "prepack": "tsc",
    "local": "tsx ./src/index.ts",
    "format": "prettier -w ./src"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "configstore": "^8.0.0",
    "enquirer": "^2.4.1",
    "figlet": "^1.11.4",
    "ora": "^9.4.1",
    "which": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/configstore": "^6.0.2",
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.1.2",
    "@types/which": "^3.0.4",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "printWidth": 120
  },
  "os": [
    "linux",
    "win32",
    "darwin"
  ],
  "keywords": [
    "btp",
    "cli",
    "cloudfoundry",
    "regions",
    "sap"
  ]
}
